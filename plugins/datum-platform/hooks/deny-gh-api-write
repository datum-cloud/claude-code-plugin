#!/usr/bin/env bash
# PreToolUse guard that keeps the read-only reviewer agents off GitHub writes,
# git mutations, cluster and deploy commands, network clients, and the shell
# wrappers that hide them. Anything outside that list (rm, package managers,
# cloud CLIs, a script file that writes) is not scanned.
#
# Fires only when the hook input's agent_type field names pr-adversary,
# pr-conventions-reviewer, or code-reviewer. A command whose text merely
# mentions one of those names does not qualify. A subagent's `tools:` line grants Bash whole,
# so nothing in an agent definition stops a command; this hook is the only
# mechanical check. It is a backstop against an accidental write by an agent
# whose prompt already says it never changes anything. It is not a control
# against a determined agent: a command can be assembled in ways this scan
# does not see, so the reviewer's prompt carries the rule and the branch
# ruleset's human approval is the last gate.
#
# What it refuses for those three agents, after normalising the command
# (line continuations joined, remaining newlines treated as `;`, whitespace
# runs collapsed, `'` and `"` stripped, backslashes stripped, lowercased):
#
#   - git mutations: push, fetch, pull, commit, tag, branch with a name or a
#     write flag, reset, checkout, switch, rebase, merge, clean, add, rm, mv,
#     apply, am, cherry-pick, revert, restore, stash, worktree add/remove/
#     prune/move, update-ref, symbolic-ref, config, remote writes, notes,
#     filter-branch, replace, gc, prune, reflog expire/delete.
#   - cluster and deploy writes: kubectl apply/delete/patch/edit/create/
#     replace/scale/rollout/cp/port-forward/drain/cordon/taint/annotate/label/
#     set/expose/run/exec/attach/debug/certificate/proxy, flux reconcile/
#     suspend/resume/create/delete/install/uninstall/bootstrap/push/tag,
#     helm install/upgrade/uninstall/rollback/push, pulumi up/destroy/refresh/
#     import, terraform apply/destroy/import, docker push, npm publish.
#   - gh writes: pr comment/review/edit/merge/ready/close/create/checkout/
#     reopen/lock/unlock/update-branch, issue comment/create/edit/close/
#     reopen/delete/transfer/pin/unpin/lock/unlock/develop, release, repo
#     create/delete/edit/fork/sync/rename/archive/unarchive/set-default,
#     workflow run/enable/disable, run rerun/cancel/delete, label create/
#     edit/delete/clone, secret, variable, ssh-key, gpg-key, auth, gist
#     create/edit/delete, cache delete, extension install/remove/upgrade,
#     config set, and project writes.
#   - gh api with -X/--method other than GET or HEAD, scanned across the
#     whole command; with -f, -F, --field, --raw-field, or --input, or with
#     `$(` or a backtick, scanned from `gh api` to the next `|`, `||`, `&&`,
#     `&`, `;`, or end of command. The one exception is `gh api graphql` whose
#     body flags all carry `query=...` inline, with no `@`, no `$(`, no
#     backtick, no `$` in the value, no --input, and no `mutation` anywhere
#     in the command.
#   - network clients and inline interpreters anywhere: curl, wget, http, xh,
#     ssh, scp, rsync, nc, telnet, python -c, python3 -c, node -e, perl -e,
#     ruby -e.
#   - shell wrappers anywhere: eval, exec, xargs, alias, source, `.` as a
#     command, sh/bash/zsh -c, env followed by gh, git, or curl, and a
#     variable assigned at the start of a segment and then expanded as the
#     command (`GH=gh; $GH api`).
#
# Accepted false positives, all refused although they read: git tag -l, git
# stash list, git branch <name> used to show one branch, git config --get,
# git reflog show, gh release view/list, gh auth status, gh secret list, gh
# variable list, kubectl exec, kubectl rollout status, flux tag list,
# `gh api ... | grep -x`, `ls -X && gh api ...`, a `-f` or `-x` token inside
# a --jq filter, gh api graphql with variables passed as separate -F flags,
# and gh api with global flags between `api` and `graphql`.
#
# Accepted false negative: quotes are stripped before the scan, so a `|`
# inside a former --jq string ends the gh api segment early and a body flag
# placed after it is not seen. The method scan still covers the whole
# command, so `--jq '.a | .b' -X POST` is refused.
#
# Fails closed once the agent_type field names a reviewer: a missing jq or
# awk, or input that is not JSON, is a refusal. Every other input, including
# the main session and every other agent, passes before any tool is required,
# so a machine without jq is blocked only for the three reviewer agents.

set -uo pipefail

refuse() {
  printf 'deny-gh-api-write: %s\n' "$1" >&2
  exit 2
}

INPUT=$(cat)

[[ "$INPUT" =~ \"agent_type\"\ *:\ *\"[^\"]*(pr-adversary|pr-conventions-reviewer|code-reviewer)\" ]] || exit 0

command -v jq >/dev/null 2>&1 || refuse "jq is not installed, so the call was refused rather than passed unchecked"
command -v awk >/dev/null 2>&1 || refuse "awk is not installed, so the call was refused rather than passed unchecked"

AGENT=$(printf '%s' "$INPUT" | jq -r '.agent_type // empty' 2>/dev/null) || refuse "hook input is not JSON, so the call was refused rather than passed unchecked"

case "${AGENT##*:}" in
  pr-adversary|pr-conventions-reviewer|code-reviewer) ;;
  *) exit 0 ;;
esac

COMMAND=$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null) || refuse "hook input is not JSON, so the call was refused rather than passed unchecked"
[ -n "$COMMAND" ] || exit 0

VERDICT=$(CMD="$COMMAND" awk '
function prog(name) {
  return "(^|[^a-z0-9_.-])([^ ]*/)?" name "( |$)"
}

function flag_value(str, re,   v) {
  if (!match(str, re)) return ""
  v = substr(str, RSTART, RLENGTH)
  sub(/^ /, "", v)
  return v
}

function bad_method(str,   rest, v) {
  rest = str
  while (match(rest, "(^| )(-x|--method)=? *[^ ]*")) {
    v = substr(rest, RSTART, RLENGTH)
    rest = substr(rest, RSTART + RLENGTH)
    sub(/^ /, "", v)
    mtok = v
    sub(/^(-x|--method)=? */, "", v)
    if (v != "get" && v != "head") return 1
  }
  return 0
}

function graphql_body_ok(seg, whole,   rest, v) {
  if (seg ~ /(^| )--input/) return 0
  if (index(seg, "@") || index(seg, "$(") || index(seg, "`") || index(whole, "mutation")) return 0
  rest = seg
  while (match(rest, "(^| )(-f|--field|--raw-field)=? *[^ ]*")) {
    v = substr(rest, RSTART, RLENGTH)
    rest = substr(rest, RSTART + RLENGTH)
    sub(/^ ?(-f|--field|--raw-field)=? */, "", v)
    if (v !~ /^query=/ || index(v, "$")) return 0
  }
  return 1
}

BEGIN {
  s = ENVIRON["CMD"]
  gsub(/\\\n/, "", s)
  gsub(/\n/, " ; ", s)
  gsub(/["\047\\]/, "", s)
  gsub(/[ \t\r]+/, " ", s)
  s = tolower(s)

  sep = "(^|[;&|({] *)"
  opts = "(-[^ ]* ([^ -][^ ]* )?)*"

  if (s ~ prog("(eval|exec|xargs|alias|source)")) { print "wrapper"; exit }
  if (s ~ (sep "\\. ")) { print "wrapper"; exit }
  if (s ~ (prog("(sh|bash|zsh)") "(-[^ ]* )*-[a-z]*c( |$)")) { print "wrapper"; exit }
  if (s ~ (prog("env") ".*" prog("(gh|git|curl)"))) { print "wrapper"; exit }
  if (s ~ (sep "((export|declare|local|typeset|readonly) )?[a-z_][a-z0-9_]*=[^ ]* *;? *\\$")) { print "wrapper"; exit }

  if (s ~ prog("(curl|wget|http|xh|ssh|scp|rsync|nc|telnet)")) { print "network"; exit }
  if (s ~ (prog("(python|python3)") "-c( |$)")) { print "network"; exit }
  if (s ~ (prog("(node|perl|ruby)") "-e( |$)")) { print "network"; exit }

  gitw = "(push|commit|tag|branch (-[dmcfu]|--delete|--move|--copy|--force|--set-upstream|--unset-upstream|--track|[^- ][^ ]*)|reset|checkout|switch|rebase|merge|worktree (add|remove|prune|move)|stash|fetch|pull|clean|apply|am|cherry-pick|revert|restore|add|rm|mv|update-ref|symbolic-ref|config|remote (add|remove|rm|rename|set-url|set-head|prune)|notes|filter-branch|replace|gc|prune|reflog (expire|delete))( |$)"
  if (s ~ (prog("git") opts gitw)) { print "git"; exit }

  k8sw = prog("kubectl") opts "(apply|delete|patch|edit|create|replace|scale|rollout|cp|port-forward|drain|cordon|uncordon|taint|annotate|label|set|expose|run|exec|attach|debug|certificate|proxy|auth reconcile)( |$)"
  fluxw = prog("flux") opts "(reconcile|suspend|resume|create|delete|install|uninstall|bootstrap|push|tag|migrate)( |$)"
  helmw = prog("helm") opts "(install|upgrade|uninstall|rollback|push|delete)( |$)"
  iacw = "(" prog("pulumi") opts "(up|destroy|refresh|import|cancel|config set|stack (rm|init))|" prog("terraform") opts "(apply|destroy|import|taint|untaint|state (rm|mv|push))|" prog("docker") opts "push|" prog("npm") opts "publish)( |$)"
  if (s ~ k8sw || s ~ fluxw || s ~ helmw || s ~ iacw) { print "cluster"; exit }

  ghw = "(pr (comment|review|edit|merge|ready|close|create|checkout|reopen|lock|unlock|update-branch)"
  ghw = ghw "|issue (comment|create|edit|close|reopen|delete|transfer|pin|unpin|lock|unlock|develop)"
  ghw = ghw "|release|repo (create|delete|edit|fork|sync|rename|archive|unarchive|set-default)"
  ghw = ghw "|workflow (run|enable|disable)|run (rerun|cancel|delete)|label (create|edit|delete|clone)"
  ghw = ghw "|secret|variable|ssh-key|gpg-key|auth|gist (create|edit|delete)|cache delete"
  ghw = ghw "|extension (install|remove|upgrade)|config set"
  ghw = ghw "|project (create|edit|delete|close|copy|link|unlink|mark-template|item-add|item-create|item-delete|item-edit|item-archive|field-create|field-delete))( |$)"
  if (s ~ (prog("gh") opts ghw)) { print "ghsub"; exit }

  ghapi = prog("gh") "(-[^ ]* )*api( |$)"
  if (s !~ ghapi) exit

  if (bad_method(s)) { print "method " mtok; exit }

  n = split(s, segs, /\|\|?|&&?|;/)
  for (i = 1; i <= n; i++) {
    if (!match(segs[i], ghapi)) continue
    seg = substr(segs[i], RSTART)
    if (index(seg, "$(") || index(seg, "`")) { print "subst"; exit }
    if (seg ~ /(^| )(-f|--field|--raw-field|--input)/) {
      if (seg ~ (prog("gh") "api graphql( |$)") && graphql_body_ok(seg, s)) continue
      print "body"; exit
    }
  }
}
')

case "$VERDICT" in
  "") exit 0 ;;
  wrapper) refuse "a shell wrapper (eval, exec, xargs, alias, source, sh -c, env, or a variable expanded as the command) is refused for this read-only reviewer; call gh and git directly" ;;
  network) refuse "a network client or inline interpreter (curl, wget, http, xh, python -c, node -e, perl -e, ruby -e) is refused for this read-only reviewer; use gh for GitHub reads" ;;
  git) refuse "a git command that changes the checkout, the refs, or the remote (push, fetch, commit, tag, branch, checkout, switch, rebase, merge, reset, clean, add, rm, apply, stash, worktree add, config) is refused for this read-only reviewer; use git diff, git log, git show, git worktree list" ;;
  ghsub) refuse "a gh subcommand that writes to GitHub (pr comment/review/edit/merge/ready, issue comment/create/edit/close, release, and similar) is refused for this read-only reviewer; use gh pr view, gh pr diff, gh pr checks, gh issue view, gh run view" ;;
  cluster) refuse "a command that changes a cluster or deploys (kubectl apply/delete/patch/exec and similar, flux reconcile/suspend/resume, helm install/upgrade, pulumi up, terraform apply, docker push) is refused for this read-only reviewer; use kubectl get/describe, flux get, kustomize build" ;;
  method*) refuse "gh api with a method other than GET or HEAD writes to GitHub and this reviewer is read-only; the method flag is scanned across the whole command and the token that matched was '${VERDICT#method }', so drop it or name GET" ;;
  subst) refuse "gh api with command substitution in its arguments hides what is sent and this reviewer is read-only; write the arguments out" ;;
  body) refuse "gh api with a body flag (-f, -F, --field, --raw-field, --input) writes to GitHub and this reviewer is read-only; the only exception is gh api graphql with inline query=... fields and no mutation" ;;
esac
